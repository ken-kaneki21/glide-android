<?xml version="1.0" encoding="utf-8"?>
<!-- E: the app turns in from the right edge (turnstile feel: grows from 92% while sliding in) -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="true"
    android:interpolator="@android:anim/decelerate_interpolator">
    <alpha android:fromAlpha="0.0" android:toAlpha="1.0" android:duration="220"/>
    <scale android:fromXScale="0.92" android:toXScale="1.0" android:fromYScale="0.96" android:toYScale="1.0"
        android:pivotX="100%" android:pivotY="50%" android:duration="300"/>
    <translate android:fromXDelta="10%p" android:toXDelta="0%p" android:duration="300"/>
</set>
